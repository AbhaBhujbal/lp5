#include<iostream>
#include<bits/stdc++.h>
#include<omp.h>

using namespace std;

vector<bool> v;
vector<vector<int>> g;

// BFS Traversal Function
void bfsTraversal(int b)
{
    queue<int> q;

    // Insert starting node
    q.push(b);

    // Mark as visited
    v[b] = true;

    cout << "\nThe BFS Traversal is: ";

    double start = omp_get_wtime();

    while(!q.empty())
    {
        int a = q.front();

        // Remove first element
        q.pop();

        #pragma omp parallel for
        for(auto j = g[a].begin(); j != g[a].end(); j++)
        {
            if(!v[*j])
            {
                v[*j] = true;

                q.push(*j);
            }
        }

        cout << a << " ";
    }

    double end = omp_get_wtime();

    cout << "\n\nTime taken => " << end - start << endl;
}

// Function to create edge
void makeEdge(int a, int b)
{
    g[a].push_back(b);
}

int main()
{
    omp_set_num_threads(4);

    int n, e;

    cout << "Consider first vertex => 0" << endl;

    cout << "\nEnter the number of vertices: ";
    cin >> n;

    cout << "\nEnter the number of edges: ";
    cin >> e;

    // Initialize visited array
    v.assign(n, false);

    // Initialize graph
    g.assign(n, vector<int>());

    int a, b, i;

    cout << "\nEnter edges with source and target vertex:\n";

    for(i = 0; i < e; i++)
    {
        cin >> a >> b;

        makeEdge(a, b);
    }

    for(i = 0; i < n; i++)
    {
        if(!v[i])
        {
            bfsTraversal(i);
        }
    }

    return 0;
}
