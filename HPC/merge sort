#include<iostream>
#include<omp.h>

using namespace std;

// Merge function
void merge(int arr[], int low, int high, int mid)
{
    int i, j, k;
    int c[50];

    i = low;
    k = low;
    j = mid + 1;

    // Merge two subarrays
    while(i <= mid && j <= high)
    {
        if(arr[i] < arr[j])
        {
            c[k] = arr[i];
            k++;
            i++;
        }
        else
        {
            c[k] = arr[j];
            k++;
            j++;
        }
    }

    // Copy remaining elements from left subarray
    while(i <= mid)
    {
        c[k] = arr[i];
        k++;
        i++;
    }

    // Copy remaining elements from right subarray
    while(j <= high)
    {
        c[k] = arr[j];
        k++;
        j++;
    }

    // Copy sorted elements back to original array
    for(i = low; i < k; i++)
    {
        arr[i] = c[i];
    }
}

// Merge Sort function
void merge_sort(int arr[], int low, int high)
{
    int mid;

    if(low < high)
    {
        mid = (low + high) / 2;

        // Parallel sections
        #pragma omp parallel sections
        {
            // First half
            #pragma omp section
            {
                merge_sort(arr, low, mid);
            }

            // Second half
            #pragma omp section
            {
                merge_sort(arr, mid + 1, high);
            }
        }

        // Merge both halves
        merge(arr, low, high, mid);
    }
}

int main()
{
    omp_set_num_threads(4);

    int arr[30], n;

    cout << "\nEnter number of elements to be sorted : ";
    cin >> n;

    cout << "\nEnter elements : ";

    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    // Function call
    merge_sort(arr, 0, n - 1);

    cout << "\nSorted array : ";

    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}
